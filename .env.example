BIRDSVISION_MODEL_PATH=/private/path/model.pth
BIRDSVISION_LABELS_PATH=/private/path/labels.json
BIRDSVISION_NUM_CLASSES=1224
# Set all three only when serving the versioned 1.0.2 route.
# BIRDSVISION_1983_MODEL_PATH=/private/path/classifier-1983.pth
# BIRDSVISION_1983_LABELS_PATH=/private/path/labels-1983.json
# BIRDSVISION_SOYOL_LOCATOR_URL=http://127.0.0.1:8001/v1/locate
# Set only in the separate locator process:
# BIRDSVISION_SOYOL_MODEL_PATH=/private/path/soyol.pt
# Set both source fields only after this exact revision is publicly readable.
# BIRDSVISION_SOURCE_REPOSITORY_URL=https://github.com/your-org/your-server
# BIRDSVISION_SOURCE_COMMIT=0000000000000000000000000000000000000000
BIRDSVISION_HOST=127.0.0.1
BIRDSVISION_PORT=8000
BIRDSVISION_AUTH_REQUIRED=true
BIRDSVISION_INFERENCE_CONCURRENCY=1
BIRDSVISION_INFERENCE_QUEUE_CAPACITY=4
